# --- docker-compose ---
POSTGRES_DB=a1
POSTGRES_USER=a1
POSTGRES_PASSWORD=degistir-beni
N8N_ENCRYPTION_KEY=uzun-rastgele-bir-deger
N8N_HOST=n8n.ornek.com
# Vapi'nin erişebileceği, HTTPS ile yayınlanan n8n adresi
N8N_PUBLIC_URL=https://n8n.ornek.com/

# --- vapi/deploy.mjs ---
VAPI_API_KEY=vapi-private-key
N8N_WEBHOOK_URL=https://n8n.ornek.com/webhook/vapi/reservations
# n8n'deki "Vapi Secret" Header Auth credential'ı ile aynı değer olmalı
VAPI_WEBHOOK_SECRET=uzun-rastgele-bir-deger
ELEVENLABS_VOICE_ID=turkce-bir-ses-idsi
COMPANY_NAME=A1 Tur
# VAPI_ASSISTANT_ID=   # doluysa mevcut asistan güncellenir
# VAPI_MODEL_PROVIDER=openai
# VAPI_MODEL=gpt-4o
