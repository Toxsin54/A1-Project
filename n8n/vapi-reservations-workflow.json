    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.github_api }}/repos/{{ $json.vault_repo }}/contents/{{ $json.result.note_path.split('/').map(encodeURIComponent).join('/') }}?ref={{ encodeURIComponent($json.vault_branch) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
