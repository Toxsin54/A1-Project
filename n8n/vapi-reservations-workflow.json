      "id": "5f48c240-d37c-5aba-ab2c-722f883ccc23",
      "name": "Get Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        560
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "credentials": {
        "githubApi": {
          "id": "REPLACE_ME",
          "name": "GitHub (Obsidian vault)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Yeni üretilen not + mevcut notun \"%% manuel-notlar %%\" altındaki kısmı (elle yazılanlar)\nconst s = $('Obsidian Settings').first().json;\nconst existing = $input.first().json;\nconst MARK = '%% manuel-notlar %%';\n\nlet manual = '\\n';\nlet sha;\nif (existing && existing.sha && typeof existing.content === 'string') {\n  sha = existing.sha;\n  const old = Buffer.from(existing.content, 'base64').toString('utf8');\n  const i = old.indexOf(MARK);\n  manual = i >= 0 ? old.slice(i + MARK.length) : '\\n\\n' + old;\n}\n\nconst text = s.result.note_content + manual;\nconst path = s.result.note_path.split('/').map(encodeURIComponent).join('/');\nconst body = {\n  message: s.result.note_message,\n  content: Buffer.from(text, 'utf8').toString('base64'),\n  branch: s.vault_branch,\n};\nif (sha) body.sha = sha;\n\nreturn [{ json: { url: `${s.github_api}/repos/${s.vault_repo}/contents/${path}`, body } }];\n"
      },
      "id": "afef6be7-1375-5ffc-9392-2b62e55fe700",
      "name": "Merge Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
